{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "anatobind/v41/prediction.schema.json",
  "title": "Prediction v4.1 (reference-free)",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "shape",
        "spacing_mm",
        "affine",
        "axis_codes",
        "units"
      ],
      "properties": {
        "shape": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "spacing_mm": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "number"
          }
        },
        "affine": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": {
              "type": "number"
            }
          }
        },
        "axis_codes": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "type": "string"
          }
        },
        "units": {
          "type": "string",
          "enum": [
            "mm"
          ]
        }
      }
    }
  },
  "required": [
    "schema_version",
    "sample_uid",
    "observation_uid",
    "mode",
    "geometry",
    "a_prob",
    "u_prob",
    "instances",
    "relations",
    "acceptance",
    "lineage"
  ],
  "properties": {
    "schema_version": {
      "const": "v41.0"
    },
    "sample_uid": {
      "type": "string"
    },
    "observation_uid": {
      "type": "string"
    },
    "mode": {
      "type": "string",
      "enum": [
        "3d",
        "strict_2d",
        "native_2d"
      ]
    },
    "geometry": {
      "$ref": "#/definitions/geometry"
    },
    "a_prob": {
      "type": [
        "string",
        "null"
      ]
    },
    "u_prob": {
      "type": [
        "string",
        "null"
      ]
    },
    "instances": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["instance_id", "class_name", "score", "voxel_count"],
        "properties": {
          "instance_id": {"type": "integer"},
          "class_name": {"type": "string"},
          "score": {"type": "number"},
          "voxel_count": {"type": "integer", "minimum": 0},
          "bbox_voxel": {"type": ["array", "null"], "minItems": 6, "maxItems": 6, "items": {"type": "integer"}},
          "host_structure": {"type": ["string", "null"]}
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["subject_instance_id", "predicate", "object_structure", "score"],
        "properties": {
          "subject_instance_id": {"type": "integer"},
          "predicate": {"type": "string"},
          "object_structure": {"type": "string"},
          "score": {"type": "number"}
        }
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "accepted"
      ],
      "properties": {
        "accepted": {
          "type": "boolean"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkpoint_sha256"],
      "properties": {
        "checkpoint_sha256": {"type": ["string", "null"]},
        "code_commit": {"type": ["string", "null"]},
        "config_sha256": {"type": ["string", "null"]},
        "run_id": {"type": ["string", "null"]}
      }
    }
  }
}
