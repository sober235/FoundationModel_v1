{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "anatobind/v5/scope.schema.json",
  "title": "ActiveScope v5.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "scope_id",
    "scope_kind",
    "anatomy_classes",
    "state_anatomy_classes",
    "abnormality_classes",
    "relation_type",
    "relation_predicate",
    "relation_contract",
    "input_modalities",
    "observation_mode",
    "normal_claim_scope",
    "reference_policy_id"
  ],
  "properties": {
    "schema_version": {
      "const": "v5.1"
    },
    "scope_id": {
      "type": "string"
    },
    "scope_kind": {
      "type": "string",
      "enum": [
        "module",
        "joint"
      ]
    },
    "anatomy_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "state_anatomy_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "abnormality_classes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "relation_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "relation_predicate": {
      "type": [
        "string",
        "null"
      ]
    },
    "relation_contract": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "target_question",
        "predicate",
        "reference_method",
        "display_name",
        "completion_role"
      ],
      "properties": {
        "target_question": {
          "type": "string"
        },
        "predicate": {
          "type": "string"
        },
        "reference_method": {
          "type": "string"
        },
        "display_name": {
          "type": "string"
        },
        "completion_role": {
          "type": "string",
          "enum": [
            "core_host_binding",
            "auxiliary_spatial"
          ]
        }
      }
    },
    "input_modalities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "observation_mode": {
      "type": "string",
      "enum": [
        "2d",
        "3d"
      ]
    },
    "normal_claim_scope": {
      "type": "string"
    },
    "reference_policy_id": {
      "type": "string"
    }
  }
}
